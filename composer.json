{
  "name": "sourcentis/mercator",
  "type": "project",
  "description": "The Mercator application.",
  "keywords": [
    "laravel",
    "framework"
  ],
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.4.1 <8.5",
    "ext-curl": "*",
    "ext-ldap": "*",
    "directorytree/ldaprecord-laravel": "^3.3",
    "fakerphp/faker": "^1.23",
    "laravel/framework": "^13.0",
    "laravel/passport": "^13",
    "laravel/sanctum": "^4.2",
    "laravel/tinker": "^3.0",
    "laravel/ui": "^4.5",
    "maatwebsite/excel": "^3.1",
    "mews/purifier": "^3.4",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0",
    "phpmailer/phpmailer": "^6.9",
    "phpoffice/phpword": "^1.4",
    "phpunit/phpunit": "^12.0",
    "socialiteproviders/keycloak": "^5.3",
    "sourcentis/chartjs-gauge": "^1.0",
    "spatie/laravel-query-builder": "^6.3",
    "yajra/laravel-datatables-buttons": "^13.0",
    "yajra/laravel-datatables-html": "^13.0"
  },
  "require-dev": {
    "baer-software/larabeacon": "^3.3",
    "larastan/larastan": "^3.8",
    "laravel/dusk": "^8.2",
    "laravel/pint": "^1.25",
    "laravel/sail": "^1.26",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.0",
    "nunomaduro/phpinsights": "^2.12",
    "orangehill/iseed": "^3.0",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/",
      "Modules\\": "modules/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
